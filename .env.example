# Copy this file to .env and fill in your credentials.
# These values are loaded by Docker Compose for all services.

# ── LLM Configuration ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-pro

# ── Alternative LLM Keys ──────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Zerodha Kite ──────────────────────────────────────────────────────────────
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ── Search ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── PostgreSQL (defaults match docker-compose.yml — only change if needed) ────
DB_HOST=db
DB_PORT=5432
DB_NAME=trading_db
DB_USER=trading_agent
DB_PASSWORD=zombie612@

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
MONGO_USERNAME=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trading_db?appName=Cluster0
MONGO_DB_NAME=trading_db

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=trading-mongo-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
